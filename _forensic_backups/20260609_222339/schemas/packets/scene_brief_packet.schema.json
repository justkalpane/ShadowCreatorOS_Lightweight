{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scene_brief_packet",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {"type": "string"},
    "route_id": {"type": "string"},
    "producer_component_id": {"type": "string"},
    "consumer_component_ids": {"type": "array", "items": {"type": "string"}},
    "lineage": {"type": "object"},
    "validation_status": {"type": "string"},
    "mission_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "timecode": {"type": "string"},
    "duration_seconds": {"type": "number"},
    "narration": {"type": "string"},
    "visual_method": {"type": "string"},
    "story_or_teaching_role": {"type": "string"},
    "provider_execution_allowed": {"type": "boolean", "default": false, "const": false},
    "approval_required": {"type": "boolean", "default": true}
  },
  "required": [
    "packet_id",
    "route_id",
    "producer_component_id",
    "consumer_component_ids",
    "lineage",
    "validation_status",
    "scene_id",
    "duration_seconds",
    "narration",
    "visual_method"
  ]
}
