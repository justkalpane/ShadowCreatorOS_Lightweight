+def parse_manifest_inline_list(manifest_text: str, key: str) -> list[str]:
+    match = re.search(rf"(?m)^[ \t]*{re.escape(key)}:\s*\[(.+?)\]\s*$", manifest_text)
+    if not match:
+        return []
+    return [item.strip().strip("'\"") for item in match.group(1).split(",") if item.strip()]
+
