+def ordered_positions(text: str, items: list[str]) -> list[tuple[str, int]]:
+    positions: list[tuple[str, int]] = []
+    for item in items:
+        pos = text.find(item)
+        if pos >= 0:
+            positions.append((item, pos))
+    return positions
+
