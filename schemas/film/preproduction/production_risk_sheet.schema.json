{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Risk Sheet",
  "type": "object",
  "required": ["production_risk_sheet", "open_questions", "blocked_items", "next_pass_recommendations", "world_context_checked"],
  "properties": {
    "production_risk_sheet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {"type": "string"},
          "mitigation": {"type": "string"}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "blocked_items": {"type": "array", "items": {"type": "string"}},
    "next_pass_recommendations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "world_context_checked": {"type": "boolean"}
  }
}
