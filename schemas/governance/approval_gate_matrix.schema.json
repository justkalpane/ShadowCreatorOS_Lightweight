{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadow Approval Gate Matrix",
  "description": "Governance matrix that maps pilot and unlock gates to their artifact requirements, route-state updates, and rollback behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_matrix_id",
    "job_id",
    "cut_id",
    "gates",
    "overall_status",
    "blocked_reasons",
    "created_at",
    "schema_version"
  ],
  "properties": {
    "gate_matrix_id": {
      "type": "string",
      "pattern": "^AGM-[A-Za-z0-9_-]+$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^JOB-[A-Za-z0-9_-]+$"
    },
    "cut_id": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "gate_sequence_index",
          "gate_name",
          "gate_owner",
          "input_artifacts",
          "input_artifact_hashes",
          "schema_name",
          "validator_name",
          "status_source_path",
          "current_status",
          "failure_code",
          "unlock_token_if_passed",
          "next_gate",
          "rollback_if_invalid",
          "evidence_bundle_required",
          "route_state_update_required"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^G[1-7]$"
          },
          "gate_sequence_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "gate_name": {
            "type": "string",
            "minLength": 1
          },
          "gate_owner": {
            "type": "string",
            "enum": [
              "ShadowOS",
              "MediaFactory",
              "Human_Founder",
              "Vayu",
              "Kubera",
              "Yama",
              "Chitragupta"
            ]
          },
          "input_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "input_artifact_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "schema_name": {
            "type": "string",
            "pattern": "^.*\\.schema\\.json$"
          },
          "validator_name": {
            "type": "string",
            "pattern": "^validate_.+\\.py$"
          },
          "status_source_path": {
            "type": "string",
            "pattern": "^/"
          },
          "current_status": {
            "type": "string",
            "enum": [
              "BLOCKED",
              "PENDING_REVIEW",
              "APPROVED",
              "SAFETY_LOCKED"
            ]
          },
          "failure_code": {
            "type": "string",
            "minLength": 1
          },
          "unlock_token_if_passed": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "next_gate": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "rollback_if_invalid": {
            "type": "string",
            "minLength": 1
          },
          "evidence_bundle_required": {
            "type": "boolean",
            "const": true
          },
          "route_state_update_required": {
            "type": "boolean"
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "BLOCKED",
        "PENDING_REVIEW",
        "APPROVED",
        "SAFETY_LOCKED"
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gates": {
            "items": {
              "properties": {
                "gate_sequence_index": {
                  "const": 7
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gates": {
            "items": {
              "if": {
                "properties": {
                  "gate_sequence_index": {
                    "const": 7
                  }
                },
                "required": [
                  "gate_sequence_index"
                ]
              },
              "then": {
                "properties": {
                  "current_status": {
                    "const": "SAFETY_LOCKED"
                  },
                  "unlock_token_if_passed": {
                    "type": "null"
                  },
                  "next_gate": {
                    "type": "null"
                  },
                  "route_state_update_required": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
