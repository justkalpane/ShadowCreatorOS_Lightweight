{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadow Packet Handoff Chain",
  "description": "Packet chain linking script intent through pilot approval and full-render unlock. Downstream packets remain blocked when upstream packets are missing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_id",
    "mission_id",
    "job_id",
    "cut_id",
    "route_id",
    "packets",
    "status",
    "created_at",
    "schema_version"
  ],
  "properties": {
    "chain_id": {
      "type": "string",
      "pattern": "^PHC-[A-Za-z0-9_-]+$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^JOB-[A-Za-z0-9_-]+$"
    },
    "cut_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "const": "MEDIA_FACTORY_HANDOFF"
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_id",
          "packet_type",
          "input_packet_ids",
          "output_packet_ids",
          "artifact_refs",
          "artifact_hashes",
          "schema_version",
          "validator_version",
          "status",
          "created_by",
          "created_at",
          "consumed_by_route",
          "route_state_update",
          "evidence_bundle_id",
          "failure_conditions"
        ],
        "properties": {
          "packet_id": {
            "type": "string",
            "pattern": "^PKT-[A-Za-z0-9_-]+$"
          },
          "packet_type": {
            "type": "string",
            "enum": [
              "script_intent_packet",
              "selected_line_visual_packet",
              "visual_density_packet",
              "image_prompt_packet",
              "base_image_packet",
              "depth_map_packet",
              "hyperframes_overlay_packet",
              "ffmpeg_filtergraph_packet",
              "segment_render_packet",
              "source_vs_render_packet",
              "contact_sheet_packet",
              "visual_qa_packet",
              "human_review_packet",
              "pilot_approval_packet",
              "pilot_execution_packet",
              "full_render_unlock_packet"
            ]
          },
          "input_packet_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_packet_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "artifact_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "validator_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "READY",
              "CONSUMED",
              "BLOCKED",
              "INVALID"
            ]
          },
          "created_by": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "consumed_by_route": {
            "type": "string",
            "const": "MEDIA_FACTORY_HANDOFF"
          },
          "route_state_update": {
            "type": "string",
            "minLength": 1
          },
          "evidence_bundle_id": {
            "type": "string",
            "pattern": "^EVB-[A-Za-z0-9_-]+$"
          },
          "failure_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "BLOCKED",
        "CONSUMED",
        "INVALID"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
