{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hyperframes_render_plan_packet",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {"type": "string"},
    "route_id": {"type": "string"},
    "producer_component_id": {"type": "string"},
    "consumer_component_ids": {"type": "array", "items": {"type": "string"}},
    "lineage": {"type": "object"},
    "validation_status": {"type": "string"},
    "scene_id": {"type": "string"},
    "layout_template": {"type": "string"},
    "template_family": {
      "type": "string",
      "enum": [
        "playstation_dashboard_panel",
        "notebooklm_dual_panel",
        "image_evidence_wall",
        "kinetic_principle_card",
        "webm_alpha_overlay"
      ]
    },
    "visual_pattern": {"type": "string"},
    "source_background": {"type": "string"},
    "floating_panel_layers": {"type": "array", "items": {"type": "string"}},
    "kinetic_text_layers": {"type": "array", "items": {"type": "string"}},
    "effect_pack_ids": {"type": "array", "items": {"type": "string"}},
    "border_pack_id": {"type": "string"},
    "animation_energy_class": {"type": "string"},
    "text_density_class": {"type": "string"},
    "lane_assignment": {
      "type": "object",
      "required": ["V1", "V2", "A1"],
      "properties": {
        "V1": {"type": "string"},
        "V2": {"type": "string"},
        "V3": {"type": "string"},
        "A1": {"type": "string"},
        "A2": {"type": "string"},
        "A3": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source_assets": {"type": "array", "items": {"type": "string"}},
    "duration_seconds": {"type": "number", "minimum": 1},
    "alpha_required": {"type": "boolean"},
    "recommended_overlay_output": {"type": "string", "enum": [".mov", ".mp4"]},
    "proof_json_path": {"type": "string"},
    "proof_gate": {"type": "string", "const": "hyperframes_proof_json"},
    "hyperframes_config": {"type": "object"},
    "output_format": {"type": "string"},
    "davinci_layering": {"type": "string"},
    "providers_called": {"type": "boolean", "const": false},
    "n8n_used": {"type": "boolean", "const": false},
    "fallback_policy": {"type": "string"},
    "provider_execution_allowed": {"type": "boolean", "default": false, "const": false},
    "approval_required": {"type": "boolean", "default": true}
  },
  "required": [
    "packet_id",
    "route_id",
    "producer_component_id",
    "consumer_component_ids",
    "lineage",
    "validation_status",
    "scene_id",
    "layout_template",
    "template_family",
    "visual_pattern",
    "source_background",
    "floating_panel_layers",
    "kinetic_text_layers",
    "effect_pack_ids",
    "border_pack_id",
    "animation_energy_class",
    "text_density_class",
    "lane_assignment",
    "source_assets",
    "duration_seconds",
    "alpha_required",
    "recommended_overlay_output",
    "proof_json_path",
    "proof_gate",
    "hyperframes_config",
    "output_format",
    "davinci_layering",
    "providers_called",
    "n8n_used",
    "fallback_policy",
    "provider_execution_allowed",
    "approval_required"
  ]
}
