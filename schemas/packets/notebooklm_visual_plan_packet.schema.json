{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notebooklm_visual_plan_packet",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {"type": "string"},
    "route_id": {"type": "string"},
    "producer_component_id": {"type": "string"},
    "consumer_component_ids": {"type": "array", "items": {"type": "string"}},
    "lineage": {"type": "object"},
    "validation_status": {"type": "string"},
    "scene_id": {"type": "string"},
    "template_family": {"type": "string", "const": "notebooklm_dual_panel"},
    "visual_pattern": {"type": "string"},
    "left_source_shelf": {"type": "array", "items": {"type": "string"}},
    "right_active_note": {"type": "string"},
    "asset_inventory": {"type": "array", "items": {"type": "string"}},
    "source_background": {"type": "string"},
    "floating_panel_layers": {"type": "array", "items": {"type": "string"}},
    "kinetic_text_layers": {"type": "array", "items": {"type": "string"}},
    "effect_pack_ids": {"type": "array", "items": {"type": "string"}},
    "border_pack_id": {"type": "string"},
    "highlight_behavior": {"type": "string"},
    "lane_assignment": {
      "type": "object",
      "required": ["V1", "A1"],
      "properties": {
        "V1": {"type": "string"},
        "V2": {"type": "string"},
        "V3": {"type": "string"},
        "A1": {"type": "string"},
        "A2": {"type": "string"},
        "A3": {"type": "string"}
      },
      "additionalProperties": true
    },
    "duration_seconds": {"type": "number", "minimum": 1},
    "proof_json_path": {"type": "string"},
    "proof_gate": {"type": "string", "const": "hyperframes_proof_json"},
    "gsap_timeline_sync": {"type": "array"},
    "hyperframes_config": {"type": "object"},
    "davinci_layering": {"type": "string"},
    "providers_called": {"type": "boolean", "const": false},
    "n8n_used": {"type": "boolean", "const": false},
    "provider_execution_allowed": {"type": "boolean", "default": false, "const": false},
    "approval_required": {"type": "boolean", "default": true}
  },
  "required": [
    "packet_id",
    "route_id",
    "producer_component_id",
    "consumer_component_ids",
    "lineage",
    "validation_status",
    "scene_id",
    "template_family",
    "visual_pattern",
    "left_source_shelf",
    "right_active_note",
    "asset_inventory",
    "source_background",
    "floating_panel_layers",
    "kinetic_text_layers",
    "effect_pack_ids",
    "border_pack_id",
    "highlight_behavior",
    "lane_assignment",
    "duration_seconds",
    "proof_json_path",
    "proof_gate",
    "gsap_timeline_sync",
    "hyperframes_config",
    "davinci_layering",
    "providers_called",
    "n8n_used",
    "provider_execution_allowed",
    "approval_required"
  ]
}
