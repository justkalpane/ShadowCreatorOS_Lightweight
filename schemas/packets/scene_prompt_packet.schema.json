{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scene_prompt_packet",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {"type": "string"},
    "route_id": {"type": "string"},
    "producer_component_id": {"type": "string"},
    "consumer_component_ids": {"type": "array", "items": {"type": "string"}},
    "lineage": {"type": "object"},
    "validation_status": {"type": "string"},
    "scene_id": {"type": "string"},
    "timestamp_range": {"type": "string"},
    "visual_method": {"type": "string"},
    "prompt": {"type": "string"},
    "visual_dna": {"type": "object"},
    "tool_targets": {"type": "array", "items": {"type": "string"}},
    "tool_specific_translation_readiness": {"type": "string"},
    "provider_execution_allowed": {"type": "boolean", "default": false, "const": false},
    "approval_required": {"type": "boolean", "default": true}
  },
  "required": [
    "packet_id",
    "route_id",
    "producer_component_id",
    "consumer_component_ids",
    "lineage",
    "validation_status",
    "scene_id",
    "timestamp_range",
    "visual_method",
    "prompt",
    "visual_dna",
    "tool_targets",
    "tool_specific_translation_readiness"
  ]
}
