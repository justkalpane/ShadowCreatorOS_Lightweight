{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard_export_packet",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "packet_id": {"type": "string"},
    "route_id": {"type": "string"},
    "producer_component_id": {"type": "string"},
    "consumer_component_ids": {"type": "array", "items": {"type": "string"}},
    "lineage": {"type": "object"},
    "validation_status": {"type": "string"},
    "mission_id": {"type": "string"},
    "scene_count": {"type": "integer"},
    "total_duration_seconds": {"type": "number"},
    "storyboard_path": {"type": "string"},
    "pacing_metadata_path": {"type": "string"},
    "scene_sync_matrix_path": {"type": "string"},
    "provider_execution_allowed": {"type": "boolean", "default": false, "const": false},
    "approval_required": {"type": "boolean", "default": true}
  },
  "required": [
    "packet_id",
    "route_id",
    "producer_component_id",
    "consumer_component_ids",
    "lineage",
    "validation_status",
    "mission_id",
    "scene_count",
    "total_duration_seconds",
    "storyboard_path",
    "pacing_metadata_path",
    "scene_sync_matrix_path"
  ]
}
